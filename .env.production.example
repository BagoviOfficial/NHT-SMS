# ==============================================================================
# NHT-SMS PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Northern Highways Transporters SACCO Management System
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=nht-sms.northernhighways.co.ke,sacco.northernhighways.co.ke,127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=nht_sacco.config.settings.production

# Database (PostgreSQL 16)
POSTGRES_DB=nht_sms_db
POSTGRES_USER=nht_sms_user
POSTGRES_PASSWORD=your_strong_database_password_here
DATABASE_URL=postgresql://nht_sms_user:your_strong_database_password_here@db:5432/nht_sms_db

# Redis & Celery Background Processing
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage Vaults
STATIC_URL=/static/
MEDIA_URL=/media/
PRIVATE_MEDIA_ROOT=/app/media/private

# Database Configuration AES-256 Encryption Keys (Independent of SECRET_KEY)
SETTINGS_ENCRYPTION_KEY=your_independent_64_character_encryption_master_key_here
SETTINGS_ENCRYPTION_KEY_FALLBACKS=optional_comma_separated_prior_encryption_keys_for_rotation

# Safaricom Daraja M-Pesa Integration (Live Credentials)
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=your_daraja_live_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_live_consumer_secret
MPESA_BUSINESS_SHORTCODE=your_paybill_or_shortcode
MPESA_PASSKEY=your_daraja_live_passkey
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=https://nht-sms.northernhighways.co.ke/api/v1/payments/mpesa/callback/
MPESA_CALLBACK_TOKEN=your_cryptographic_callback_bearer_token

# Africa's Talking SMS Integration
AT_ENVIRONMENT=production
AT_USERNAME=your_africas_talking_production_username
AT_API_KEY=your_africas_talking_production_api_key
AT_SENDER_ID=NHT-SACCO

# Meta WhatsApp Cloud API Integration
WHATSAPP_ENVIRONMENT=production
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verification_token

# Transactional Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_smtp_api_key
DEFAULT_FROM_EMAIL=Northern Highways Transporters SACCO <noreply@northernhighways.co.ke>

# Security & Session Controls
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
NOTIFICATION_SIMULATION_MODE=False

