# ==============================================================================
# NHT-SMS ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Northern Highways Transporters SACCO Management System
# ==============================================================================

# DJANGO CORE
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,::1
DJANGO_SETTINGS_MODULE=nht_sacco.config.settings.development

# DATABASE (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
POSTGRES_DB=nht_sms_db
POSTGRES_USER=nht_sms_user
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://u0_a366:@localhost:5432/nht_sms_db

# CACHE & BACKGROUND BROKER (Redis)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# MEDIA & STATIC PATHS
STATIC_URL=/static/
MEDIA_URL=/media/
PRIVATE_MEDIA_ROOT=/data/data/com.termux/files/home/NHT-SMS/media/private

# SAFARICOM DARAJA M-PESA INTEGRATION (Sandbox by default)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_sandbox_consumer_secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=https://your-domain.example/api/v1/payments/mpesa/callback/
MPESA_CALLBACK_TOKEN=change-to-a-cryptographic-callback-token

# AFRICA'S TALKING SMS INTEGRATION
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=

# META WHATSAPP BUSINESS CLOUD API INTEGRATION
WHATSAPP_ENVIRONMENT=sandbox
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verification_token

# EMAIL (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Northern Highways Transporters <info@nhttransporters.co.ke>

# SECURITY SETTINGS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=28800
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
